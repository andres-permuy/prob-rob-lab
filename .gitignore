# Python and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Generated ROS workspace output
/build/
/install/
/log/

# Rebuildable submission artifacts; keep reports, video, and evidence in Git
/submission/*/source/
/submission/*/MANIFEST.sha256
/submission/*.zip
/submission/*.zip.tmp

# Local source recordings and report backups (never submit or commit)
/local_archive/

# Editor and OS temporary files
*.swp
*~
*.bak
.DS_Store
~$*
~WRL*.tmp
